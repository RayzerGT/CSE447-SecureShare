# Copy this file to .env and fill in real values. Never commit the real .env file.

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-value

# --- Shared team database (Aiven MySQL) ---
# All teammates use the SAME central database (not separate local ones) so
# everyone sees the same data and the same migration state. Ask a teammate
# for the real values (Aiven dashboard -> your service -> "Connection
# information") - do not commit real credentials anywhere, including in
# this file (only .env, which is gitignored, should ever hold real values).
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=change-me
MYSQL_HOST=your-service-name.aivencloud.com
MYSQL_PORT=13477
# Aiven requires TLS. Leave this as REQUIRED for Aiven. If you point this at
# a local MySQL/MariaDB without SSL configured, set MYSQL_SSL_MODE= (empty).
MYSQL_SSL_MODE=REQUIRED

# Session lifetime: sessions are force-expired (server-side, not just cookie
# deletion) this many minutes after login - see accounts/security/session_manager.py
SESSION_COOKIE_SECURE=False
SESSION_TIMEOUT_MINUTES=5
