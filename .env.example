# Copy this file to .env and fill in real values. Never commit the real .env file.

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-value

# ---------------------------------------------------------------------------
# Which database to use
# ---------------------------------------------------------------------------
#   sqlite -> a local db.sqlite3 file. No credentials, no network, no setup.
#             This is the default and what you want for normal development.
#   mysql  -> the team's shared central database on Aiven. Used for the
#             project demonstration, and whenever you need the shared data.
#
# Switching is only ever this one line - the app code and migrations are
# identical for both. Run `python manage.py dbinfo` to confirm which one
# you're currently on.
DB_ENGINE=sqlite

# Optional: filename for the sqlite database (relative to the repo root).
# Handy if you want a throwaway DB to experiment in: SQLITE_NAME=scratch.sqlite3
#SQLITE_NAME=db.sqlite3

# --- Shared team database (Aiven MySQL) -- only read when DB_ENGINE=mysql ---
# Ask a teammate for the real values (Aiven dashboard -> your service ->
# "Connection information") - do not commit real credentials anywhere,
# including in this file (only .env, which is gitignored, should ever hold
# real values).
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=change-me
MYSQL_HOST=your-service-name.aivencloud.com
MYSQL_PORT=13477
# Aiven requires TLS. Leave this as REQUIRED for Aiven. If you point this at
# a local MySQL/MariaDB without SSL configured, set MYSQL_SSL_MODE= (empty).
MYSQL_SSL_MODE=REQUIRED

# Session lifetime: sessions are force-expired (server-side, not just cookie
# deletion) this many minutes after login - see accounts/security/session_manager.py
SESSION_COOKIE_SECURE=False
SESSION_TIMEOUT_MINUTES=5
